# PostgreSQL connection string for the Supabase project.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Vercel should use the Supabase transaction-pooler URL. One connection per
# serverless instance avoids exhausting the project connection limit.
PG_POOL_MAX=1
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=5000
PG_MAX_LIFETIME_SECONDS=300
PG_STATEMENT_TIMEOUT_MS=30000

# Separate disposable/test database used by `npm run test:integration`.
# Never point this at a production database.
TEST_DATABASE_URL=postgresql://postgres:password@test-host:5432/postgres

# Optional server configuration.
PORT=5000
NODE_ENV=development

# Backend-only key used for Admin user invitations. Paste only the key value on one line:
# no "Bearer " prefix, quotes, spaces, or VITE_ variable. Never expose it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# Legacy fallback only: SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Protects the daily overdue-monitoring endpoint. Use a long random value.
# Configure the same CRON_SECRET in the deployed backend environment.
CRON_SECRET=replace-with-a-long-random-secret
